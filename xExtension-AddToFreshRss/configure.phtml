<?php

declare(strict_types=1);

/** @var AddToFreshRssExtension $this */

$baseUrl = rtrim(FreshRSS_Context::systemConf()->base_url, '/');
$subscribeUrl = $baseUrl . '/?c=subscription&a=add&url_rss=';
$bookmarklet = 'javascript:(function(){var f=document.querySelector(\'link[rel=alternate][type="application/rss+xml"],link[rel=alternate][type="application/atom+xml"]\');var u=f?f.href:window.location.href;window.location=' . json_encode($subscribeUrl) . '+encodeURIComponent(u);})();';
?>
<div class="form-group">
	<label class="group-name"><?= _t('ext.add_to_freshrss.bookmarklet_title') ?></label>
	<div class="group-controls">
		<p class="help"><?= _t('ext.add_to_freshrss.bookmarklet_help') ?></p>
		<a href="<?= htmlspecialchars($bookmarklet, ENT_QUOTES, 'UTF-8') ?>"
		   class="btn"
		   ondragstart="return true;"><?= _t('ext.add_to_freshrss.bookmarklet_link') ?></a>
	</div>
</div>
<div class="form-group">
	<label class="group-name"><?= _t('ext.add_to_freshrss.url_title') ?></label>
	<div class="group-controls">
		<p class="help"><?= _t('ext.add_to_freshrss.url_help') ?></p>
		<input type="text"
		       class="input-xxlarge"
		       readonly="readonly"
		       onclick="this.select();"
		       value="<?= htmlspecialchars($subscribeUrl . '{FEED_URL}', ENT_QUOTES, 'UTF-8') ?>" />
	</div>
</div>
